# System One model server: a systemd USER unit template.
# Install as ~/.config/systemd/user/system-one.service after replacing every @@...@@ placeholder below
# (the list is in references/system-one.md, Machine setup). %h is systemd's own home specifier and stays as is.
# Loopback-only server: delete the EnvironmentFile line and the --host and --token-env options.
# The token never goes in this file: @@TOKEN_ENV_FILE@@ is a file only you can read, holding one line
# SYSTEM_ONE_TOKEN=<your token>.
[Unit]
Description=gitos System One decision model server (@@MODEL_NAME@@)

[Service]
WorkingDirectory=@@SYSTEM_ONE_DIR@@
EnvironmentFile=@@TOKEN_ENV_FILE@@
ExecStart=@@VENV_PYTHON@@ @@SYSTEM_ONE_DIR@@/serve_general.py @@MODEL_DIR@@ --host 0.0.0.0 --port @@PORT@@ --token-env SYSTEM_ONE_TOKEN --warmup
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
